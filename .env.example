# GitHub API Credentials
# Optional for public repos, recommended for higher rate limits (5,000 req/hour) & private repos
GITHUB_TOKEN=your_personal_access_token_here

# LLM Provider Configuration
# Supported providers: OpenAI, Google Gemini, Anthropic, Ollama, etc.
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini
# Optional custom API base (e.g. http://localhost:11434/v1 for Ollama)
# LLM_API_BASE=http://localhost:11434/v1

# GitHub Model Context Protocol (MCP) Configuration
MCP_ENABLED=true
# Optional external MCP server launch command (e.g., npx -y @modelcontextprotocol/server-github)
# MCP_SERVER_COMMAND=npx -y @modelcontextprotocol/server-github

# Analysis & Reporting Configuration
OUTPUT_DIR=reports
LOG_LEVEL=INFO
MAX_FILES_FOR_AST=60
MAX_ISSUES_TO_FETCH=50
MAX_PRS_TO_FETCH=30
MAX_COMMITS_TO_FETCH=50
